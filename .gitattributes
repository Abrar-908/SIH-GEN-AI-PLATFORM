# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly LF for key config files
*.yaml eol=lf
*.yml eol=lf
Procfile eol=lf
*.py eol=lf
*.ts eol=lf
*.tsx eol=lf
*.json eol=lf
*.md eol=lf
*.sh eol=lf

# Binary files - no line ending conversion
*.pdf binary
*.docx binary
*.pptx binary
*.db binary
*.png binary
*.jpg binary
*.ico binary
