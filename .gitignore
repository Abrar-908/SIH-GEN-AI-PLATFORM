# ============================================================
# IntelTransform AI - Root .gitignore
# ============================================================

# ── Python / Backend ─────────────────────────────────────────
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/*.db
backend/*.db-shm
backend/*.db-wal
backend/.pytest_cache/
backend/.env
backend/.env.*
backend/data/
backend/data/uploads/*
backend/data/exports/*
backend/data/samples/__pycache__/

# ── Node / Frontend ──────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
frontend/.env
frontend/.env.*

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Exports / Uploads (keep folder structure) ────────────────
exports/*
!exports/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/exports/*
!data/exports/.gitkeep
